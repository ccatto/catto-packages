{
  "name": "@ccatto/imagekit",
  "version": "1.2.0",
  "description": "Catto ImageKit — reusable ImageKit upload auth signer, client upload, URL transforms, and a React upload component. No keys embedded; the consuming app injects them.",
  "license": "MIT",
  "author": "Chris Catto",
  "keywords": [
    "imagekit",
    "image",
    "upload",
    "cdn",
    "react",
    "nextjs",
    "catto"
  ],
  "homepage": "https://github.com/ccatto/catto-packages/tree/main/packages/imagekit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccatto/catto-packages.git",
    "directory": "packages/imagekit"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "yarn clean",
    "build": "tsc -p tsconfig.build.json && node scripts/mark-client.mjs",
    "clean": "rimraf dist",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
