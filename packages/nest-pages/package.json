{
  "name": "@ccatto/nest-pages",
  "version": "1.0.1",
  "description": "Catto Pages - NestJS module for admin-authored nested content pages (a page CMS): tree, path resolution, drag-reorder, draft/publish",
  "license": "MIT",
  "author": "Chris Catto",
  "keywords": [
    "nestjs",
    "cms",
    "pages",
    "content",
    "prisma",
    "graphql",
    "catto"
  ],
  "homepage": "https://github.com/ccatto/catto-packages/tree/main/packages/nest-pages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccatto/catto-packages.git",
    "directory": "packages/nest-pages"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prebuild": "yarn clean",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@ccatto/nest-auth": "^1.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/graphql": "^13.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.0",
    "rimraf": "^6.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@ccatto/nest-auth": ">=1.0.0",
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "@nestjs/graphql": ">=12.0.0",
    "class-transformer": ">=0.5.0",
    "class-validator": ">=0.14.0",
    "reflect-metadata": ">=0.1.0"
  }
}
