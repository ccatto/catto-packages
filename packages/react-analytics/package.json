{
  "name": "@ccatto/react-analytics",
  "version": "1.1.0",
  "description": "Catto Analytics - drop-in Google Analytics 4 for Next.js + Capacitor: <GoogleAnalyticsCatto/>, trackEvent(), and Capacitor platform dimensions",
  "license": "MIT",
  "author": "Chris Catto",
  "keywords": [
    "react",
    "nextjs",
    "google-analytics",
    "ga4",
    "analytics",
    "third-parties",
    "typescript",
    "catto"
  ],
  "homepage": "https://github.com/ccatto/catto-packages/tree/main/packages/react-analytics",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccatto/catto-packages.git",
    "directory": "packages/react-analytics"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "import": "./dist/platform.js",
      "require": "./dist/platform.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@next/third-parties": "^16.0.0",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "glob": "^13.0.0",
    "jsdom": "^27.4.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "@next/third-parties": ">=14.0.0",
    "next": ">=14.0.0",
    "react": ">=18.0.0"
  }
}
